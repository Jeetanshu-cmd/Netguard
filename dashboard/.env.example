# Copy to .env.local for local dev overrides.

# Set to "true" to use the in-browser mock API/WebSocket layer instead of a
# real backend. Useful for demoing the UI before api/ is wired up.
VITE_USE_MOCKS=false

# Optional. Leave unset to use same-origin (/api via the Vite proxy in dev, root in prod).
# VITE_API_BASE_URL=http://localhost:8000

# Optional WebSocket base URL (no query string). Unset = same host as the page.
# VITE_WS_BASE_URL=ws://localhost:8000
