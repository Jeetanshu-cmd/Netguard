# Copy to .env.local for local dev overrides.

# Set to "true" to use the in-browser mock API/WebSocket layer instead of a
# real backend. Useful for demoing the UI before api/ is wired up.
# TODO(backend): flip to "false" once api/ (FastAPI) is running and reachable.
VITE_USE_MOCKS=true

# Base URL for REST calls. Ignored while VITE_USE_MOCKS=true.
VITE_API_BASE_URL=http://localhost:8000

# WebSocket base URL (no query string). Ignored while VITE_USE_MOCKS=true.
VITE_WS_BASE_URL=ws://localhost:8000
